<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="NavigationPage">
        <Setter Property="BackgroundColor" Value="{StaticResource MainBackColor}" />
    </Style>

    <Style TargetType="Button" x:Key="GlobalButtonStyle">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="BackgroundColor" Value="{StaticResource ButtonColor1}" />
        <Setter Property="WidthRequest" Value="300" />
        <Setter Property="MinimumHeightRequest" Value="60" />
        <Setter Property="Margin" Value="20" />
    </Style>

    <Style TargetType="Label" x:Key="GlobalLabelStyle">
        <Setter Property="TextColor" Value="{StaticResource MainTextColor}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="KeyboardWhiteKey" TargetType="Button">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="Black" />
        <Setter Property="BorderColor" Value="Black" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="WidthRequest" Value="45" />
        <Setter Property="HeightRequest" Value="170" />
    </Style>

    <Style x:Key="KeyboardBlackKey" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Black" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="WidthRequest" Value="30" />
        <Setter Property="HeightRequest" Value="110" />
    </Style>

</ResourceDictionary>
