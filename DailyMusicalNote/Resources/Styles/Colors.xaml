<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Black">#000</Color>
    <Color x:Key="White">#FFF</Color>
    
    <Color x:Key="MainBackColor">#CCC</Color>
    <Color x:Key="MainTextColor">Black</Color>
    <Color x:Key="ChosenOption">#777</Color>
    <Color x:Key="ButtonColor1">Black</Color>
    <Color x:Key="KeySharpedPressed">#333</Color>
    <Color x:Key="KeyPressed">#888</Color>

    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
</ResourceDictionary>