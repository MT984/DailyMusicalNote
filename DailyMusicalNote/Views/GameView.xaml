<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyMusicalNote.Views.GameView"
             NavigationPage.HasNavigationBar="False"
             Title="GameView">
    <VerticalStackLayout>
        <HorizontalStackLayout
            x:Name="Staff"
            HorizontalOptions="Center">
            <Image Source="empty_staff.png"
                   WidthRequest="550"
                   Margin="20"
                   Aspect="AspectFit" />
        </HorizontalStackLayout>
        <HorizontalStackLayout x:Name="Keyboard" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>