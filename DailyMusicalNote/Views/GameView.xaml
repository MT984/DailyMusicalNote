<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyMusicalNote.Views.GameView"
             NavigationPage.HasNavigationBar="False"
             xmlns:resx="clr-namespace:DailyMusicalNote.Resources.Lang"
             Title="GameView"
             x:Name="GameViewContentPage">
    <Grid RowDefinitions="*,*" ColumnDefinitions="*">
        <Frame
            Padding="8,2"
            HasShadow="True"
            BackgroundColor="{StaticResource KeyPressed}"
            HeightRequest="24"
            HorizontalOptions="Fill"
            VerticalOptions="Start">
            
            <HorizontalStackLayout>

                <Label x:Name="TimeLabel"
                       Text="{Static resx:langResources.labelTime}"
                       TextColor="{StaticResource White}"
                       FontSize="14"
                       WidthRequest="90"
                       VerticalOptions="Center" />

                <Label Text="{Static resx:langResources.labelNote}"
                       TextColor="{StaticResource White}"
                       FontSize="14"
                       Margin="30,0,0,0"
                       HorizontalTextAlignment="End"/>
                
                <Label x:Name="NotesLabel"
                       Text=" "
                       TextColor="{StaticResource White}"
                       FontSize="14"
                       WidthRequest="40"
                       HorizontalTextAlignment="End"/>

                <Label x:Name="PauseLabel"
                       Text="&#x275A;&#x275A;"
                       TextColor="{StaticResource White}"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       WidthRequest="50"
                       Margin="550,0,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="PauseOnClick" />
                    </Label.GestureRecognizers>
                </Label>

            </HorizontalStackLayout>
        </Frame>
        <Grid
            x:Name="Staff"
            VerticalOptions="Start"
            HorizontalOptions="Center"
            Grid.Row="0">
            <Image Source="empty_staff.png"
                   WidthRequest="550"
                   Margin="20"
                   Aspect="AspectFit" />
            
            <Image Source="rest.png"
                   WidthRequest="550"
                   Margin="300,20,20,20"
                   Aspect="AspectFit" />
            
            <Image Source="time_sign.png"
                   WidthRequest="550"
                   Margin="-200,20,20,20"
                   Aspect="AspectFit" />

            <Image Source="sharp.png"
                   WidthRequest="550"
                   Margin="-100,20,20,20"
                   Aspect="AspectFit" />

            <Image Source="treble_clef.png"
                   WidthRequest="550"
                   Margin="-400,20,20,20"
                   Aspect="AspectFit"
                   x:Name="TrebleImage"
                   IsVisible="False"/>

            <Image Source="bass_clef.png"
                   WidthRequest="550"
                   Margin="-400,20,20,20"
                   Aspect="AspectFit"
                   x:Name="BassImage"
                   IsVisible="False"/>

            <Image Source="down_staff.png"
                   WidthRequest="550"
                   Margin="100,20,20,20"
                   Aspect="AspectFit"
                   IsVisible="False"
                   x:Name="DownStaff" />
            
            <Image Source="top_staff.png"
                   WidthRequest="550"
                   Margin="100,20,20,20"
                   Aspect="AspectFit"
                   IsVisible="False"
                   x:Name="TopStaff" />
            
            <Image Source="a3.png"
                   Margin="100,20,20,20"
                   Aspect="AspectFit"
                   IsVisible="False"
                   x:Name="NoteImage"/>

            <Image Source="v.png"
                   Margin="-650,20,20,20"
                   Aspect="AspectFit"
                   IsVisible="False"
                   x:Name="CorrectImage"/>

            <Image Source="x.png"
                   Margin="-650,20,20,20"
                   Aspect="AspectFit"
                   IsVisible="False"
                   x:Name="InvalidImage"/>

        </Grid>
        <HorizontalStackLayout
            x:Name="Keyboard"
            HorizontalOptions="Center"
            Grid.Row="1"/>
    </Grid>
</ContentPage>