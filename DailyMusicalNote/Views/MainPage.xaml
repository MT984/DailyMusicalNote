<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resx="clr-namespace:DailyMusicalNote.Resources.Lang"
             x:Class="DailyMusicalNote.Views.MainPage"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource GlobalButtonStyle}" />
        <Style TargetType="Label" BasedOn="{StaticResource GlobalLabelStyle}" />
    </ContentPage.Resources>

    <StackLayout Margin="20" Spacing="10">

        <Label Text="{Static resx:langResources.labelMenuTitle}"
               VerticalTextAlignment="Center"
               FontSize="60"
               Padding="30" />
        
        <Button Text="{Static resx:langResources.buttonMenuStart}"
                ClassId="bStart"
                Clicked="OnButtonClicked"/>
        
        <Button Text="{Static resx:langResources.buttonMenuHistory}"
                ClassId="bHistory"
                Clicked="OnButtonClicked" />
        
        <Button Text="{Static resx:langResources.buttonMenuExit}"
                ClassId="bExit"
                Clicked="OnButtonClicked" />
        
    </StackLayout>

</ContentPage>
